{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "packages/runtimes/openclaw/scripts/cli-exec-worker.mjs",
    "packages/runtimes/openclaw/templates/**",
    "scripts/backfill-route-frontmatter.mjs"
  ],
  "ignoreDependencies": [
    "@digital-me/contracts",
    "yaml"
  ],
  "ignoreBinaries": [
    "hermes",
    "husky",
    "openclaw"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "duplicates": "warn",
    "enumMembers": "warn"
  }
}
