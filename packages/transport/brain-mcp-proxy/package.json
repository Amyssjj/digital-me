{
  "name": "@digital-me/brain-mcp-proxy",
  "version": "0.1.0-pre",
  "description": "Stdio (and HTTP) MCP server registered as `digital-me-brain`: forwards tool calls to brain-host's /tools/invoke wire so any MCP-capable CLI (Claude Code, Codex, Hermes) reaches the brain.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "digital-me-brain-mcp-proxy": "./bin/brain-mcp-proxy.mjs",
    "digital-me-brain-mcp-http": "./bin/brain-mcp-http.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin/brain-mcp-proxy.mjs": "./bin/brain-mcp-proxy.mjs",
    "./bin/brain-mcp-http.mjs": "./bin/brain-mcp-http.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@digital-me/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
