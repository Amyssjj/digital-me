{
  "name": "@digital-me/brain-host",
  "version": "0.1.0-pre",
  "description": "brain-host \u2014 the always-on process that serves the digital-me-brain: retrieval (memory_search / memory_get / wiki over wiki + tastes, hybrid FTS5 + embeddings) and brain-orchestrator's operations on one authenticated /tools/invoke wire.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "digital-me-brain-host": "./bin/brain-host.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin/brain-host.mjs": "./bin/brain-host.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@digital-me/brain-orchestrator": "workspace:*",
    "@digital-me/contracts": "workspace:*",
    "@digital-me/runtime-openclaw": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.5"
  }
}
