{
  "name": "@digital-me/dashboard",
  "version": "0.1.0-pre",
  "description": "Digital Me OA Dashboard \u2014 minimal 4-view surface (Metrics / Mechanism / Kanban / Delivery) over openclaw brain state + the dashboard-intake pipeline.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server/lib.js",
  "exports": {
    ".": {
      "types": "./dist/server/lib.d.ts",
      "import": "./dist/server/lib.js"
    },
    "./drift-status": {
      "types": "./dist/server/drift-status.d.ts",
      "import": "./dist/server/drift-status.js"
    }
  },
  "files": [
    "dist",
    "src",
    "workflows",
    "vite.config.ts",
    "index.html",
    "postcss.config.js"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:client": "vite",
    "start": "tsx src/server/server.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@digital-me/brain-mcp-proxy": "workspace:*",
    "@digital-me/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.6.2",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@digital-me/brain-orchestrator": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.5"
  }
}
